=== Test Constructor ===

  .globl _l_mkPair
  .align 2
_l_mkPair:
  // Function: mkPair
  stp x29, x30, [sp, #-16]!
  mov x29, sp
  stp x19, x20, [sp, #-16]!
  stp x21, x22, [sp, #-16]!
  sub sp, sp, #16
  // Stack frame: 16 spill + 32 saved regs (gp 2/5, fp 0/4)
.Lfn_start_mkPair:
  mov x19, x0
  mov x20, x1
  // ctor Pair (tag=0, objs=2, usize=0, scalar=0)
  mov x0, #0
  mov x1, #2
  mov x2, #0
  bl _lean_alloc_ctor
  mov x21, x0
  str x19, [x21, #8]
  str x20, [x21, #16]
  // return
  mov x0, x21
  add sp, sp, #16
  ldp x21, x22, [sp], #16
  ldp x19, x20, [sp], #16
  ldp x29, x30, [sp], #16
  ret


