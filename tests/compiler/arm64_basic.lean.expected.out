ARM64 Backend Tests
====================

=== Test Add ===

  .globl _l_testAdd
  .align 2
_l_testAdd:
  // Function: testAdd
  stp x29, x30, [sp, #-16]!
  mov x29, sp
  stp x19, x20, [sp, #-16]!
  stp x21, x22, [sp, #-16]!
  sub sp, sp, #16
  // Stack frame: 16 spill + 32 saved regs (gp 2/5, fp 0/4)
.Lfn_start_testAdd:
  mov x19, x0
  mov x20, x1
  // call Nat.add with 2 runtime args
  mov x0, x19
  mov x1, x20
  bl _l_Nat_add
  mov x21, x0
  // return
  mov x0, x21
  add sp, sp, #16
  ldp x21, x22, [sp], #16
  ldp x19, x20, [sp], #16
  ldp x29, x30, [sp], #16
  ret


