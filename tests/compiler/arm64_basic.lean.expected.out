ARM64 Backend Tests
====================

=== Test Add ===

  .globl _l_testAdd
  .align 2
_l_testAdd:
  // Function: testAdd
  stp x29, x30, [sp, #-16]!
  mov x29, sp
  // save param 0: xx0 → xx19
  mov x19, x0
  // save param 1: xx1 → xx20
  mov x20, x1
  // call Nat.add with 2 args
  mov x0, x19
  mov x1, x20
  bl _l_Nat_add
  mov x27, x0
  // return
  mov x0, x27
  ldp x29, x30, [sp], #16
  ret


