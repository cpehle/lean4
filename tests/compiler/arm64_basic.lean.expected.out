=== Test Case ===

  .globl _l_notBool
  .align 2
_l_notBool:
  // Function: notBool
  stp x29, x30, [sp, #-16]!
  mov x29, sp
  stp x19, x20, [sp, #-16]!
  sub sp, sp, #16
  // Stack frame: 16 spill + 16 saved regs (gp 1/5, fp 0/4)
.Lfn_start_notBool:
  mov x19, x0
  // case
  // runtime scalar check
  tst x19, #1
  b.ne .scalar_tag_notBool_0
  ldrb w8, [x19, #7]
  b .compare_tag_notBool_1
.scalar_tag_notBool_0:
  lsr x8, x19, #1
.compare_tag_notBool_1:
  cmp x8, #0
  b.eq .case_ctor_notBool_3
  cmp x8, #1
  b.eq .case_ctor_notBool_4
  b .case_end_notBool_2
.case_ctor_notBool_3:
  // return
  mov x0, x19
  add sp, sp, #16
  ldp x19, x20, [sp], #16
  ldp x29, x30, [sp], #16
  ret
  b .case_end_notBool_2
.case_ctor_notBool_4:
  // return
  mov x0, x19
  add sp, sp, #16
  ldp x19, x20, [sp], #16
  ldp x29, x30, [sp], #16
  ret
  b .case_end_notBool_2
.case_end_notBool_2:
  add sp, sp, #16
  ldp x19, x20, [sp], #16
  ldp x29, x30, [sp], #16
  bl _lean_internal_panic_unreachable
  ret


